__pycache__/
*.pyc

# Generated state output. Rule 9: a committed timestamped snapshot of machine
# state reads as a fact about the project rather than about one moment.
dashboard/status-board.html
dashboard/part-monitor.html
dashboard/board.html

# The board's frontend build. Sources are tracked; node_modules and the two
# bundle outputs are re-made by `npm install && npm run build`.
dashboard/web/node_modules/
dashboard/web/dist/
dashboard/web/dist-single/

# Secrets never enter this repository. See docs/secrets.md — values live in
# ~/.config, encrypted with sops+age, outside every repo.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets*
*secret*
*credential*
keys.txt
*.enc.yaml

# The inventory doc carries no values and must stay tracked.
!docs/secrets.md
# Code that bridges the encrypted store into the process environment -- no
# value in either file, only the sops call and the env-var names (docs/
# secrets.md's own "the repo carries the inventory" principle, applied to
# code rather than docs). Named for what it does, which collides with the
# pattern above by design; verified before allowing.
!runtime/secrets_reader.py
!tests/runtime/test_secrets_reader.py
dashboard/wiring-explorer.html

# Rendered spec and plan pages: generated from the .md by dashboard/render_spec.py
docs/superpowers/specs/*.html
docs/superpowers/plans/*.html

# Samples a measurement script takes of this machine's live state. The script is
# the deliverable and the summary is quoted where it is used; a timestamped dump
# of one machine-minute committed here would read as a fact about the project
# rather than about that minute (Rule 8, and the same reason the boards are not
# committed).
measurements/*/samples.jsonl
measurements/*/summary.txt
